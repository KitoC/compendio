
# Supabase URL (for authentication and database)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase Functions URL (for Edge Functions including WebSocket)
# For local WebSocket with remote Supabase, keep this as local URL
# even if VITE_SUPABASE_URL points to remote
VITE_SUPABASE_FUNCTIONS_URL=http://127.0.0.1:54321

# Set this to true to use local WebSocket with remote Supabase
VITE_USE_LOCAL_WEBSOCKET=false

# Debug mode for WebSockets (set to true for detailed logs)
VITE_WEBSOCKET_DEBUG=false
