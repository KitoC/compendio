# Backend Architecture

## Supabase Backend Architecture

The application leverages Supabase Edge Functions for backend operations that require server-side execution. The Supabase-related code is organized in a structured way to promote code reuse and maintainability.

### Directory Structure

```
supabase/
├── functions/               # Supabase Edge Functions
│   ├── _shared/             # Shared code between functions
│   │   ├── services/        # Backend services
│   │   ├── utils/           # Utility functions
│   │   ├── controllers/     # Logic controllers
│   │   └── factories/       # Factory patterns
│   │
│   ├── function-1/          # Individual function directory
│   │   └── index.ts         # Function entry point
│   │
│   ├── function-2/
│   │   └── index.ts
│   │
│   └── ...
│
└── migrations/              # Database migrations
    ├── 20240101000000_initial_schema.sql
    ├── 20240115000000_add_user_profiles.sql
    └── ...
```

### Edge Function Organization

Each Edge Function is contained in its own directory with a standardized structure:

```typescript
// supabase/functions/example-function/index.ts
import { serve } from "https://deno.land/std@0.177.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2.7.1";
import { handleAuth } from "../_shared/utils/auth.ts";
import { ExampleController } from "../_shared/controllers/example-controller.ts";

serve(async (req) => {
  try {
    // Handle CORS preflight requests
    if (req.method === "OPTIONS") {
      return new Response(null, {
        headers: {
          "Access-Control-Allow-Origin": "*",
          "Access-Control-Allow-Methods": "POST, OPTIONS",
          "Access-Control-Allow-Headers": "Content-Type, Authorization",
        },
      });
    }

    // Parse request
    const { method, body } = await handleAuth(req);

    // Initialize controller
    const controller = new ExampleController();

    // Route to appropriate method
    switch (method) {
      case "GET":
        return await controller.get(body);
      case "POST":
        return await controller.create(body);
      case "PUT":
        return await controller.update(body);
      case "DELETE":
        return await controller.delete(body);
      default:
        throw new Error(`Method ${method} not supported`);
    }
  } catch (error) {
    console.error(`Error: ${error.message}`);

    return new Response(
      JSON.stringify({
        error: error.message || "An unexpected error occurred",
      }),
      {
        status: error.status || 500,
        headers: {
          "Content-Type": "application/json",
          "Access-Control-Allow-Origin": "*",
        },
      }
    );
  }
});
```

### Shared Code Organization

The `_shared` directory contains code that is reused across multiple functions:

#### Controllers

Controllers handle the business logic for specific domains:

```typescript
// supabase/functions/_shared/controllers/example-controller.ts
import { ExampleService } from "../services/example-service.ts";
import { validateSchema } from "../utils/validation.ts";
import { exampleSchema } from "../schemas/example-schema.ts";

export class ExampleController {
  private service: ExampleService;

  constructor() {
    this.service = new ExampleService();
  }

  async get(params) {
    const data = await this.service.getAll(params);

    return new Response(JSON.stringify({ data }), {
      headers: { "Content-Type": "application/json" },
    });
  }

  async create(params) {
    // Validate input
    const validatedData = validateSchema(exampleSchema, params);

    // Process request
    const result = await this.service.create(validatedData);

    return new Response(JSON.stringify({ data: result }), {
      headers: { "Content-Type": "application/json" },
    });
  }

  // Other controller methods...
}
```

#### Services

Backend services handle database interactions:

```typescript
// supabase/functions/_shared/services/example-service.ts
import { getSupabaseClient } from "../utils/supabase.ts";

export class ExampleService {
  private supabase;

  constructor() {
    this.supabase = getSupabaseClient();
  }

  async getAll(params = {}) {
    const { data, error } = await this.supabase.from("examples").select("*");

    if (error) throw error;

    return data;
  }

  async create(data) {
    const { data: result, error } = await this.supabase
      .from("examples")
      .insert(data)
      .select()
      .single();

    if (error) throw error;

    return result;
  }

  // Other service methods...
}
```

#### Utilities

Shared utility functions for common operations:

```typescript
// supabase/functions/_shared/utils/auth.ts
import { createClient } from "https://esm.sh/@supabase/supabase-js@2.7.1";

export async function handleAuth(req) {
  // Extract the authorization header
  const authHeader = req.headers.get("Authorization");

  if (!authHeader) {
    throw { message: "Missing Authorization header", status: 401 };
  }

  // Create supabase client with auth context
  const supabase = createClient(
    Deno.env.get("SUPABASE_URL") ?? "",
    Deno.env.get("SUPABASE_ANON_KEY") ?? "",
    {
      global: {
        headers: { Authorization: authHeader },
      },
    }
  );

  // Get the user from the request
  const {
    data: { user },
    error,
  } = await supabase.auth.getUser();

  if (error || !user) {
    throw { message: "Unauthorized", status: 401 };
  }

  // Parse request body
  let body = {};
  if (req.method !== "GET" && req.method !== "HEAD") {
    body = await req.json();
  }

  // Add user info to the body
  body.user_id = user.id;

  return {
    method: req.method,
    body,
    user,
  };
}
```

### Database Migrations

The `migrations` directory contains SQL files for database schema changes. These migrations are automatically applied in order by Supabase:

```sql
-- supabase/migrations/20240101000000_initial_schema.sql
-- Create tables for the initial schema
CREATE TABLE public.users (
  id UUID REFERENCES auth.users NOT NULL PRIMARY KEY,
  email TEXT NOT NULL,
  first_name TEXT,
  last_name TEXT,
  avatar_url TEXT,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL,
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT now()
);

-- Set up Row Level Security
ALTER TABLE public.users ENABLE ROW LEVEL SECURITY;

-- Create policy for users to only see their own data
CREATE POLICY "Users can view their own data"
  ON public.users
  FOR SELECT
  USING (auth.uid() = id);

-- Create policy for users to only update their own data
CREATE POLICY "Users can update their own data"
  ON public.users
  FOR UPDATE
  USING (auth.uid() = id);

-- Create triggers for updated_at
CREATE FUNCTION public.update_modified_column()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = now();
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER update_users_updated_at
BEFORE UPDATE ON public.users
FOR EACH ROW
EXECUTE FUNCTION public.update_modified_column();
```

### Integration with Frontend

The frontend interacts with Supabase Edge Functions through a dedicated service:

```typescript
// src/services/supabase/functions-service.ts
import { supabase } from "@/integrations/supabase/client";

type FunctionOptions = {
  headers?: Record<string, string>;
};

export class FunctionsService {
  static async invoke<T = unknown, R = unknown>(
    functionName: string,
    payload?: T,
    options: FunctionOptions = {}
  ): Promise<R> {
    const { data, error } = await supabase.functions.invoke(functionName, {
      body: payload,
      headers: options.headers,
    });

    if (error) throw error;

    return data as R;
  }
}

// Usage example:
// const result = await FunctionsService.invoke('example-function', { id: 123 });
```

## Database Design

### Table Relationships

Supabase uses PostgreSQL under the hood, allowing for full relational database capabilities:

```
┌─────────────┐       ┌─────────────┐       ┌─────────────┐
│             │       │             │       │             │
│    Users    │       │   Projects  │       │    Tasks    │
│             │       │             │       │             │
└──────┬──────┘       └──────┬──────┘       └──────┬──────┘
       │                     │                     │
       │ 1                   │ 1                   │ N
       ▼                     ▼                     ▼
┌─────────────┐       ┌─────────────┐       ┌─────────────┐
│             │ N     │             │ 1     │             │
│ Team_Members│◄──────┤    Teams    ├───────┤Project_Tasks│
│             │       │             │       │             │
└─────────────┘       └─────────────┘       └─────────────┘
```

### Row-Level Security (RLS)

Supabase RLS policies ensure data isolation and security:

```sql
-- Example RLS policies for a projects table
-- Only team members can view projects
CREATE POLICY "Team members can view projects"
ON projects
FOR SELECT
USING (
  auth.uid() IN (
    SELECT user_id FROM team_members
    WHERE team_id = projects.team_id
  )
);

-- Only project owners can update projects
CREATE POLICY "Project owners can update projects"
ON projects
FOR UPDATE
USING (auth.uid() = owner_id);
```

### Database Triggers

Triggers are used for maintaining data integrity and implementing business rules:

```sql
-- Automatically update the updated_at timestamp
CREATE TRIGGER set_updated_at
BEFORE UPDATE ON projects
FOR EACH ROW
EXECUTE FUNCTION update_modified_column();

-- Notify about important changes
CREATE TRIGGER notify_project_update
AFTER UPDATE ON projects
FOR EACH ROW
WHEN (OLD.status <> NEW.status)
EXECUTE FUNCTION notify_project_status_change();
```

### Database Functions

PostgreSQL functions provide reusable database operations:

```sql
-- Function to get all projects a user has access to
CREATE OR REPLACE FUNCTION get_accessible_projects(user_id UUID)
RETURNS SETOF projects AS $$
BEGIN
  RETURN QUERY
  SELECT p.*
  FROM projects p
  JOIN team_members tm ON p.team_id = tm.team_id
  WHERE tm.user_id = user_id;
END;
$$ LANGUAGE plpgsql;

-- Usage: SELECT * FROM get_accessible_projects('user-uuid-here');
```
